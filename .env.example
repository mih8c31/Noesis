# ============================================
# Noesis — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha os valores
# NUNCA versione o .env.local

# --------------------------------------------
# Supabase
# --------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------
# AI Providers (usadas APENAS em Edge Functions)
# --------------------------------------------
# Estas variáveis NÃO são acessíveis pelo frontend
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# --------------------------------------------
# App
# --------------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Noesis
